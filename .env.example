# Discord Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Team Filtering (optional, leave empty for all matches)
# Names must match the feeds, which use short names: OpTic, FaZe, M80, Cloud9,
# Falcons, G2, Gentle Mates, Heretics, KOI, Royal Ravens, Surge, Thieves
# TEAMS=OpTic,FaZe

# Team IDs for ICS Feeds (optional, comma-separated)
# Example: TEAM_IDS=blt19237b20a0dd1b07,blt1234567890abcdef
# TEAM_IDS=

# Notification Settings
NOTIFY_MINUTES_BEFORE=15
SCHEDULE_FETCH_INTERVAL=60

# Discord Mentions (optional)
# DISCORD_MENTION_ROLE_ID=your_role_id_here
# DISCORD_PING_EVERYONE=false

# ICS Feed Configuration
# Season year used in the feed directory (the 2026-27 season is "2027")
CDL_SEASON=2027
# Full override of the feed base URL (normally derived from CDL_SEASON)
# ICS_BASE_URL=https://cdl-public-archive.s3.us-east-2.amazonaws.com/CDL-calendar-sync/2027
